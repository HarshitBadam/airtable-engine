# Copy to .env, then add the Google credentials below.
# The database values can stay as-is when using start-database.sh locally.

# PostgreSQL. The start script may offer to replace the sample password.
DATABASE_URL=postgresql://postgres:password@localhost:5432/airtable

# Prisma uses a direct connection for migrations. It can match DATABASE_URL
# locally. In production, keep DATABASE_URL pooled and set this to the
# database's direct connection.
DIRECT_URL=postgresql://postgres:password@localhost:5432/airtable

# Google sign-in (Auth.js).
# Create the OAuth client at console.cloud.google.com/apis/credentials.
# Generate a local secret with: npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: shared rate limiting through Upstash Redis.
# Without both values, the app uses an in-memory limiter. That is fine for
# local development, but it is not shared between serverless instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
